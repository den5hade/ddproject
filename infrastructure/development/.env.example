# Local development stack environment.
# Copy to .env and optionally override the dev defaults below.
# Used both for Docker Compose variable substitution and as env_file for the
# account-api / workers containers.

# ----------------------------------------------------------------- Infra
POSTGRES_USER=pdf
POSTGRES_PASSWORD=pdf123
POSTGRES_DB=pdf_platform

RABBITMQ_USER=pdf
RABBITMQ_PASSWORD=pdf123

# --------------------------------------------------------------- account-api
# DATABASE_URL / REDIS_URL / RABBITMQ_URL hosts are overridden inside
# docker-compose.yml to container names; set everything else here.
APP_NAME="DDProject"
DEBUG=True
API_PREFIX="/api/v1"

# Auth secrets (dev only — replace with random values via `openssl rand -hex 32`)
JWT_SECRET_KEY=super-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
AUTH_PIN_PEPPER=super-secret-pin-pepper
AUTH_OTP_PEPPER=super-secret-otp-pepper
AUTH_HMAC_KEY=super-secret-hmac-key

# --------------------------------------------------- objectstorage-worker
S3_ENDPOINT_URL=https://s3.cloud.ru
S3_KEY_ID=change-me
S3_KEY_SECRET=change-me
S3_BUCKET_NAME=ddp-app-bucket
S3_REGION=ru-central-1

# --------------------------------------------------- notification-worker
NOTIFICATION_PROVIDER=smtp
SMTP_HOST=change-me
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@ddproject.local
SMTP_USE_TLS=true