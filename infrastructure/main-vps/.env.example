# Main VPS environment. Copy to .env and fill in real values.
# RABBITMQ_URL points to the rabbitmq-vps tailnet IP (100.x.y.z); password from .env.
RABBITMQ_URL=amqp://pdf:change-me@100.64.0.10:5672/

S3_ENDPOINT_URL=https://s3.ru1.storage.cloud.ru
S3_KEY_ID=change-me
S3_KEY_SECRET=change-me
S3_TENANT_ID=change-me
S3_BUCKET_NAME=pdf-documents
S3_REGION=us-east-1

POSTGRES_USER=pdf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pdf_platform
DATABASE_URL=postgresql+asyncpg://pdf:change-me@postgres:5432/pdf_platform

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
AUTH_PIN_PEPPER=change-me
AUTH_OTP_PEPPER=change-me
AUTH_HMAC_KEY=change-me

REDIS_URL=redis://redis:6379/0

AI_FEATURE=true
AI_BASE_URL=https://foundation-models.api.cloud.ru/v1
AI_API_KEY=change-me
AI_MODEL=google/gemini-3-pro-image-preview
AI_EMBEDDING_BASE_URL=https://foundation-models.api.cloud.ru/v1
AI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AI_EMBEDDING_DIMENSION=1024

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=change-me

CLOUD_PROVIDER=digitalocean
CLOUD_API_TOKEN=change-me
MARKER_WORKER_IMAGE=registry.example.com/pdf-ai-platform/marker-worker:latest
