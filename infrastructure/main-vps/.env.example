# Main VPS environment. Copy to .env and fill in real values.
# RABBITMQ_URL points to the rabbitmq-vps tailnet IP (100.x.y.z).
RABBITMQ_URL=amqp://pdf:pdf123@100.64.0.10:5672/

S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=pdf-documents
S3_REGION=us-east-1

POSTGRES_USER=pdf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pdf_platform
DATABASE_URL=postgresql+asyncpg://pdf:change-me@postgres:5432/pdf_platform

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents

CLOUD_PROVIDER=digitalocean
CLOUD_API_TOKEN=change-me
MARKER_WORKER_IMAGE=registry.example.com/pdf-ai-platform/marker-worker:latest
