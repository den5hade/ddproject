# ------------------------------------------------------------------
# Shared infrastructure (used by multiple services)
# ------------------------------------------------------------------

# RabbitMQ (local dev default; in prod point to the rabbitmq-vps tailnet IP)
RABBITMQ_URL=amqp://pdf:pdf123@localhost:5672/

# S3-compatible storage (MinIO locally, Object Storage in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pdf-documents
S3_REGION=us-east-1

# ------------------------------------------------------------------
# account-api
# ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pdf:pdf123@localhost:5432/pdf_platform
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Origin of the web SPA (CORS, only needed if not same-origin via nginx)
WEB_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------
# ai-worker
# ------------------------------------------------------------------
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# ------------------------------------------------------------------
# marker-orchestrator (provider-specific, see infrastructure/main-vps/.env.example)
# ------------------------------------------------------------------
CLOUD_PROVIDER=digitalocean
CLOUD_API_TOKEN=change-me
MARKER_WORKER_IMAGE=registry.example.com/pdf-ai-platform/marker-worker:latest
