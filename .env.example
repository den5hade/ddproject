PYTHONPATH=app

# ==========================================
# 🌐 Общие настройки
# ==========================================
APP_NAME="DDProject"
DEBUG=True
API_PREFIX="/api/v1"

# ==========================================
# 🐇 RabbitMQ credentials (NOT hardcoded in config)
# ==========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=pdf
RABBITMQ_PASSWORD=<your-rabbitmq-password>
RABBITMQ_VHOST=/

# ==========================================
# 🗄 PostgreSQL настройки
# ==========================================
# Для PostgreSQL (если нужно):
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/ddproject

# PostgreSQL credentials (if using PostgreSQL)
POSTGRES_DB=ddproject

POSTGRES_USER=<your-postgres-user>

POSTGRES_PASSWORD=<your-postgres-password>

# ==========================================
# 🔐 Auth настройки (СЕКРЕТЫ)
# ==========================================

# ⚠️ ОБЯЗАТЕЛЬНО ЗАМЕНИТЕ НА СВОИ СЛУЧАЙНЫЕ СТРОКИ
# Генерируйте командой: openssl rand -hex 32
JWT_SECRET_KEY="super-secret-key-at-least-32-chars-long"
AUTH_PIN_PEPPER="super-secret-pin-pepper"
AUTH_OTP_PEPPER="super-secret-otp-pepper"
AUTH_HMAC_KEY="super-secret-hmac-key"
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30


# ==========================================
# ☁️ S3 Object Storage Credentials
# ==========================================

S3_ENDPOINT_URL=https://s3.ru1.storage.cloud.ru
S3_KEY_ID=<your-s3-key-id>
S3_KEY_SECRET=<your-s3-key-secret>
S3_TENANT_ID=<your-s3-tenant-id>
S3_BUCKET_NAME=ddp-app-bucket

# ==========================================
# 📄 Document upload pipeline (account-api + objectstorage-worker)
# ==========================================

# Shared folder between account-api and objectstorage-worker (mount the same
# volume in production); account-api stages files here, the worker picks them up.
STORAGE_TEMP_DIR=./tmp/uploads

# Per-file upload limit in bytes (50 MiB)
MAX_UPLOAD_BYTES=52428800

# account-api consumer: which queue it reads pipeline events from
DOCUMENT_EVENTS_QUEUE=document_events
DOCUMENT_EVENTS_ROUTING_KEYS=document.stored,document.converted,document.analysis.completed,document.processing.failed

# objectstorage-worker: which queue it reads upload requests from
OBJECTSTORAGE_QUEUE=document.upload
OBJECTSTORAGE_ROUTING_KEYS=document.upload.requested

# ==========================================
# 💡 Прочее
# ==========================================
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# 🤖 AI Feature (Cloud.ru DeepSeek-OCR-2)
# ==========================================
AI_FEATURE=True
AI_BASE_URL=https://foundation-models.api.cloud.ru/v1
AI_API_KEY=<your-ai-api-key>
# AI_MODEL=deepseek-ai/DeepSeek-OCR-2
AI_MODEL="google/gemini-3-pro-image-preview"

AI_EMBEDDING_BASE_URL="https://foundation-models.api.cloud.ru/v1"
AI_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
AI_EMBEDDING_DIMENSION=1024


# ==========================================
# Qdrant Vector Store (required for AI matching)
# ==========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=<your-qdrant-api-key>


# ==========================================
# ✉️ notification-worker (OTP delivery)
# ==========================================
NOTIFICATION_QUEUE=auth_otp
NOTIFICATION_ROUTING_KEYS=auth.otp.requested
# console (dev) or smtp (prod)
NOTIFICATION_PROVIDER=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ddproject.local
SMTP_USE_TLS=true