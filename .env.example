PYTHONPATH=app

# ==========================================
# 🌐 Общие настройки
# ==========================================
APP_NAME="DDProject"
DEBUG=True
API_PREFIX="/api/v1"

# ==========================================
# 📝 Request/response logging (account-api)
# ==========================================
# Request bodies may contain PII/medical data.
# Keep LOG_REQUEST_BODY=False in production unless you explicitly need it.
ENABLE_REQUEST_LOGGING=True
LOG_REQUEST_BODY=False
LOG_RESPONSE_BODY=False
# Max body length (in bytes) captured when body logging is enabled.
MAX_LOG_BODY_SIZE=10000

# ==========================================
# 🐇 RabbitMQ credentials (NOT hardcoded in config)
# ==========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=pdf
RABBITMQ_PASSWORD=<your-rabbitmq-password>
RABBITMQ_VHOST=/

# ==========================================
# 🗄 PostgreSQL настройки
# ==========================================
# Для PostgreSQL (если нужно):
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/ddproject

# PostgreSQL credentials (if using PostgreSQL)
POSTGRES_DB=ddproject

POSTGRES_USER=<your-postgres-user>

POSTGRES_PASSWORD=<your-postgres-password>

# ==========================================
# 🔐 Auth настройки (СЕКРЕТЫ)
# ==========================================

# ⚠️ ОБЯЗАТЕЛЬНО ЗАМЕНИТЕ НА СВОИ СЛУЧАЙНЫЕ СТРОКИ
# Генерируйте командой: openssl rand -hex 32
JWT_SECRET_KEY="super-secret-key-at-least-32-chars-long"
AUTH_PIN_PEPPER="super-secret-pin-pepper"
AUTH_OTP_PEPPER="super-secret-otp-pepper"
AUTH_HMAC_KEY="super-secret-hmac-key"
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30


# ==========================================
# ☁️ S3 Object Storage Credentials
# ==========================================

S3_ENDPOINT_URL=https://s3.ru1.storage.cloud.ru
S3_KEY_ID=<your-s3-key-id>
S3_KEY_SECRET=<your-s3-key-secret>
S3_TENANT_ID=<your-s3-tenant-id>
S3_BUCKET_NAME=ddp-app-bucket
S3_REGION=ru-central-1

# ==========================================
# 📄 Document upload pipeline (account-api + objectstorage-worker)
# ==========================================

# Shared folder between account-api and objectstorage-worker (mount the same
# volume in production); account-api stages files here, the worker picks them up.
STORAGE_TEMP_DIR=./tmp/uploads

# Per-file upload limit in bytes (50 MiB)
MAX_UPLOAD_BYTES=52428800

# account-api consumer: which queue it reads pipeline events from
DOCUMENT_EVENTS_QUEUE=document_events
DOCUMENT_EVENTS_ROUTING_KEYS=document.stored,document.converted,document.analysis.completed,document.processing.failed

# objectstorage-worker: which queue it reads upload requests from
OBJECTSTORAGE_QUEUE=document.upload
OBJECTSTORAGE_ROUTING_KEYS=document.upload.requested

# ==========================================
# 💡 Прочее
# ==========================================
REDIS_URL="redis://localhost:6379/0"

# ==========================================
# 🤖 AI Feature (Cloud.ru DeepSeek-OCR-2)
# ==========================================
AI_FEATURE=True
AI_BASE_URL=https://foundation-models.api.cloud.ru/v1
AI_API_KEY=<your-ai-api-key>
# AI_MODEL=deepseek-ai/DeepSeek-OCR-2
AI_MODEL="google/gemini-3-pro-image-preview"

AI_EMBEDDING_BASE_URL="https://foundation-models.api.cloud.ru/v1"
AI_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
AI_EMBEDDING_DIMENSION=1024


# ==========================================
# 🔐 PII Gate (ai-worker)
# ==========================================

# HMAC key for PII value fingerprints. No default: ai-worker refuses to start
# its PII gate while this is empty. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_FINGERPRINT_SECRET=<your-pii-fingerprint-secret>

# Which trust boundary AI_BASE_URL sits on, and therefore whether the PII gate
# redacts before the extraction call.
#   internal_llm (default) — the provider in AI_BASE_URL is on our side of the
#                            boundary. Nothing is redacted, because the gate
#                            trusts it explicitly. Adding a provider means
#                            adding it to TRUSTED_INTERNAL_URLS in
#                            apps/ai-worker/app/pii/policy.py first: the worker
#                            refuses to start on internal_llm + an unlisted URL,
#                            rather than sending documents unredacted to a
#                            boundary the configuration does not name.
#   external_llm          — the provider is untrusted. The 18 identity, contact,
#                            government and medical-id categories are masked in
#                            the text sent to the model, and the redacted text is
#                            stored as redacted.md. Doctor, clinic and clinical
#                            facts survive, so notes stay legible.
# NOT COVERED: OCR. AI_BASE_URL also drives the OCR call, which runs before the
# gate and sends the page image itself. See "Boundaries this pipeline does not
# gate" in apps/ai-worker/app/pipeline/pipeline.py.
LLM_MODE=internal_llm


# ==========================================
# Qdrant Vector Store (required for AI matching)
# ==========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=<your-qdrant-api-key>


# ==========================================
# ✉️ notification-worker (OTP + document notifications)
# ==========================================
NOTIFICATION_QUEUE=auth_otp
NOTIFICATION_ROUTING_KEYS=auth.otp.requested,notification.requested
# console (dev) or smtp (prod)
NOTIFICATION_PROVIDER=console

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ddproject.local
SMTP_USE_TLS=true